generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  urls      Url[]
}

model Url {
  id          String   @id @default(uuid())
  shortCode   String   @unique
  originalUrl String
  clicks      Int      @default(0)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  analytics   ClickAnalytics[]
}

model ClickAnalytics {
  id         String   @id @default(uuid())
  shortUrlId String
  url        Url      @relation(fields: [shortUrlId], references: [id])
  ipAddress  String?
  userAgent  String?
  referrer   String?
  clickedAt  DateTime @default(now())
}